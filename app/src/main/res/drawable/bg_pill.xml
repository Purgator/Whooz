<?xml version="1.0" encoding="utf-8"?>
<!-- Sub-mode pill over the arena: a translucent dark capsule with a hairline so it reads as
     chrome and never competes with the player colors. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="200dp" />
    <solid android:color="#A6141924" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
