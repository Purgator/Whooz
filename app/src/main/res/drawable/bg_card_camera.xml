<?xml version="1.0" encoding="utf-8"?>
<!-- Permission card and status banner over the preview: a dark rounded surface that stays
     readable whatever the camera shows behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_stroke" />
    <corners android:radius="16dp" />
</shape>
