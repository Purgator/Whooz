<?xml version="1.0" encoding="utf-8"?>
<!-- Roll call: the preview and the roll-call overlay fill the window edge to edge; the chrome
     (mode buttons, status, the bottom row with New group / Go / Pick 1-2) lives in camera_chrome,
     which receives the bar and cutout insets as padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <fr.arichard.whooz.camera.RollCallView
        android:id="@+id/rollcall_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/camera_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_finger"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_finger"
            app:srcCompat="@drawable/ic_hand"
            app:tint="@color/chrome_ghost" />

        <!-- Back to the group camera mode: everyone in the frame at once. -->
        <ImageButton
            android:id="@+id/btn_camera"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|start"
            android:layout_marginStart="64dp"
            android:layout_marginTop="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_camera"
            app:srcCompat="@drawable/ic_camera"
            app:tint="@color/chrome_ghost" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/chrome_ghost" />

        <include layout="@layout/include_camera_status" />

        <!-- Explicit actions stay separate from the portrait strip: tapping a portrait selects it,
             and only this button can remove it. Capture is an optional early photo trigger. -->
        <TextView
            android:id="@+id/rollcall_remove"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="180dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/rollcall_remove_player"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rollcall_capture"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="132dp"
            android:background="@drawable/bg_go_disabled"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="112dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/rollcall_capture"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Bottom row: forget or restore a group, run the draw, choose how many winners. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rollcall_new_group"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="@string/rollcall_new_group"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/rollcall_recent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="@string/rollcall_recent_groups"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The old single action is intentionally kept as the draw's strong centre button. -->
            <TextView
                android:id="@+id/rollcall_go"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_weight="0"
                android:background="@drawable/bg_go_disabled"
                android:clickable="true"
                android:elevation="4dp"
                android:enabled="false"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="112dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/rollcall_go"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/camera_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_camera"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/chip_pick_1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/mode_winner_1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chip_pick_2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/mode_winner_2"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
