<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-built settings: a plain ScrollView of rows, no preference library. The inner column
     receives the system-bar insets as padding so the content scrolls under the bars. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Top row: back arrow + title (Toolbar-less on purpose, no Material dependency). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="@dimen/settings_padding">

            <ImageButton
                android:id="@+id/settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                app:srcCompat="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- ===== Play ===== -->
        <TextView
            style="@style/Whooz.Settings.Section"
            android:text="@string/settings_play_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_padding"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/settings_padding"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Whooz.Settings.Title"
                android:text="@string/settings_delay" />

            <TextView
                style="@style/Whooz.Settings.Subtitle"
                android:text="@string/settings_delay_summary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_fast"
                    style="@style/Whooz.Settings.Chip"
                    android:text="@string/settings_delay_fast" />

                <TextView
                    android:id="@+id/chip_normal"
                    style="@style/Whooz.Settings.Chip"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/settings_delay_normal" />

                <TextView
                    android:id="@+id/chip_slow"
                    style="@style/Whooz.Settings.Chip"
                    android:text="@string/settings_delay_slow" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_haptics"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_haptics" />

                <TextView
                    style="@style/Whooz.Settings.Subtitle"
                    android:text="@string/settings_haptics_summary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_haptics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_keep_screen_on"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_keep_screen_on" />

                <TextView
                    style="@style/Whooz.Settings.Subtitle"
                    android:text="@string/settings_keep_screen_on_summary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_keep_screen_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_remember_mode"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_remember_mode" />

                <TextView
                    style="@style/Whooz.Settings.Subtitle"
                    android:text="@string/settings_remember_mode_summary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_remember_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- ===== Updates ===== -->
        <TextView
            style="@style/Whooz.Settings.Section"
            android:text="@string/settings_updates_section" />

        <LinearLayout
            android:id="@+id/row_auto_update"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_auto_update" />

                <TextView
                    style="@style/Whooz.Settings.Subtitle"
                    android:text="@string/settings_auto_update_summary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_check_now"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_check_now" />

                <TextView
                    android:id="@+id/check_now_status"
                    style="@style/Whooz.Settings.Subtitle"
                    android:text="@string/update_checking"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== About ===== -->
        <TextView
            style="@style/Whooz.Settings.Section"
            android:text="@string/settings_about_section" />

        <LinearLayout
            style="@style/Whooz.Settings.Row"
            android:background="@null">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/version_text"
                    style="@style/Whooz.Settings.Subtitle"
                    tools:text="Version 1.0 (1)" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_github"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_github" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Whooz.Settings.Divider" />

        <LinearLayout
            android:id="@+id/row_licenses"
            style="@style/Whooz.Settings.Row">

            <LinearLayout style="@style/Whooz.Settings.RowText">

                <TextView
                    style="@style/Whooz.Settings.Title"
                    android:text="@string/settings_licenses" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
