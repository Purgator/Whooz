<?xml version="1.0" encoding="utf-8"?>
<!-- Camera mode: the preview and the face overlay fill the window edge to edge; every piece of
     chrome lives in camera_chrome, which receives the bar and cutout insets as padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <fr.arichard.whooz.camera.FaceOverlayView
        android:id="@+id/camera_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/camera_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_finger"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_finger"
            app:srcCompat="@drawable/ic_hand"
            app:tint="@color/chrome_ghost" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/chrome_ghost" />

        <include layout="@layout/include_camera_status" />

        <!-- Roll call: enrol players one at a time, for groups that do not fit in the frame. -->
        <ImageButton
            android:id="@+id/btn_rollcall"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/chrome_margin"
            android:layout_marginEnd="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_rollcall"
            app:srcCompat="@drawable/ic_people"
            app:tint="@color/chrome_ghost" />

        <!-- Sub-mode pill: camera mode only picks one or two winners. -->
        <LinearLayout
            android:id="@+id/camera_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pill_camera"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/chip_pick_1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/mode_winner_1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pill_text" />

            <TextView
                android:id="@+id/chip_pick_2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/mode_winner_2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pill_text" />
        </LinearLayout>

    </FrameLayout>
</FrameLayout>
