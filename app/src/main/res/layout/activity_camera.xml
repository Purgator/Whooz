<?xml version="1.0" encoding="utf-8"?>
<!-- Camera mode: the preview and the face overlay fill the window edge to edge; every piece of
     chrome lives in camera_chrome, which receives the bar and cutout insets as padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arena">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <fr.arichard.whooz.camera.FaceOverlayView
        android:id="@+id/camera_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/camera_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btn_finger"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_finger"
            app:srcCompat="@drawable/ic_hand"
            app:tint="@color/chrome_ghost" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/chrome_button"
            android:layout_height="@dimen/chrome_button"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/chrome_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/chrome_ghost" />

        <!-- ML Kit / camera status: model download, Play services missing, no camera. -->
        <LinearLayout
            android:id="@+id/camera_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card_camera"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/camera_banner_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="@string/mlkit_downloading" />

            <TextView
                android:id="@+id/camera_banner_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/perm_use_finger"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/camera_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:shadowColor="@color/arena"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/hint_text"
            tools:text="@string/hint_camera_idle" />

        <!-- "Using back camera": shown while no front camera exists. -->
        <TextView
            android:id="@+id/camera_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="88dp"
            android:shadowColor="@color/arena"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/hint_back_camera"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/hint_text_small"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Sub-mode pill: camera mode only picks one or two winners. -->
        <LinearLayout
            android:id="@+id/camera_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_pill_camera"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/chip_pick_1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/mode_winner_1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pill_text" />

            <TextView
                android:id="@+id/chip_pick_2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/mode_winner_2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pill_text" />
        </LinearLayout>

        <!-- Permission card: shown after a denial, with the right call to action. -->
        <LinearLayout
            android:id="@+id/perm_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_card_camera"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_camera_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/perm_camera_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/perm_use_finger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/perm_use_finger"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/perm_allow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/perm_allow"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/perm_open_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/perm_open_settings"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
