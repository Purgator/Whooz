<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recent_group_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recent_group_item_height"
    android:layout_marginBottom="@dimen/recent_group_item_gap"
    android:background="@drawable/bg_recent_group"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/recent_group_item_padding"
    android:paddingEnd="@dimen/recent_group_item_padding">

    <LinearLayout
        android:id="@+id/recent_group_portraits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/recent_group_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/recent_group_label_gap"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/recent_group_label_text" />

</LinearLayout>